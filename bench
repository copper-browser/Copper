                                       extension, a dialog) — held for the bench in a headless test run;
                                       answer it by button number, title, or the start of its title;
                                       selftest puts up a SwiftUI dialog and answers it end to end
    ./bench settings browse folder PATH|ask [PATH|cancel|folder|reset]|prefs|glyph letters|icons
                                       Downloads' Change… as a pick of PATH; how "Ask where to save" is
                                       answered in a test run, and the names it was asked about; the
                                       Browsing pages' values (test runs only)
    ./bench settings browse scroll [top|bottom|next|PX]
                                       move the open page's scroll as the wheel would; where it is,
                                       and whether anything on it is wider than the column (test runs only)
    ./bench settings browse picture spaces|extensions|voice|cloud|updates|intelligence|agents|labs PATH [WIDTH] [light|dark]
                                       the whole page as a PNG, laid out at a page-column WIDTH
                                       (345 is Settings' narrowest), not scrolled
    ./bench ui KEY VALUE               settings/passwords/welcome/history/downloads/bookmarks/hidden on|off,
                                       look light|dark|system, sidebar on|off, folded on|off, peek on|off,
                                       tabswitch row|recent, page general|tabs (which Settings page), focus none (the keyboard to the window itself), width N (the sidebar),
                                       addressHover on|off (the sidebar's address pill as under the pointer), clearHover on|off (force the Clear divider visible)

Needs Settings › General › "Let a script drive Copper" switched on in the
running app. IDs are the first characters of a tab's id, as `tabs` prints
them. With --test, talks to a SEARCH_PROBE run instead of the real one;
with --world NAME, to a SEARCH_PROBE=NAME run, the world "Copper (NAME)".
A development build opened without SEARCH_PROBE is the world "dev": drive it
with --world dev; plain ./bench talks to the installed Copper.
"""

import json
import os
import socket
import sys

def folder(world):
    name = f"Copper ({world})" if world else "Copper"
    return os.path.expanduser(f"~/Library/Application Support/{name}")

def ask(path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(path)
        except (FileNotFoundError, ConnectionRefusedError):
            sys.exit("Copper isn't listening — is it open, with Settings › General › "
                     "“Let a script drive Copper” on?")
        s.sendall((json.dumps(request) + "\n").encode())
        chunks = []
        while True:
            chunk = s.recv(1 << 16)
            if not chunk:
                break
            chunks.append(chunk)
    line = b"".join(chunks).split(b"\n", 1)[0]
    return json.loads(line or b"{}")

def main(argv):
    world = "test" if "--test" in argv else None
    if "--world" in argv:
        at = argv.index("--world")
        if at + 1 >= len(argv): sys.exit("usage: bench --world NAME COMMAND …")
        world = "".join(c for c in argv[at + 1].lower() if c.isascii() and (c.isalnum() or c == "-"))
        if world in ("", "1"): world = "test"
        argv = argv[:at] + argv[at + 2:]
    yes = "--yes" in argv
    argv = [a for a in argv if a not in ("--test", "--yes")]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    verb, args = argv[0], argv[1:]
    request = {"do": verb}
    if verb == "open":
        if len(args) != 1: sys.exit("usage: bench open URL")
        request["url"] = args[0]
    elif verb == "go":
        if len(args) != 2: sys.exit("usage: bench go ID URL")
        request["id"], request["url"] = args
    elif verb in ("wait",):
        if not args: sys.exit("usage: bench wait ID [SECONDS]")
        request["id"] = args[0]
        if len(args) > 1: request["seconds"] = float(args[1])
    elif verb in ("text", "close", "sleep", "select"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
    elif verb == "eval":
        if len(args) != 2: sys.exit("usage: bench eval ID JS")
        request["id"], request["js"] = args
    elif verb in ("click", "submit"):
        if len(args) != 2: sys.exit(f"usage: bench {verb} ID SELECTOR")
        request["id"], request["selector"] = args
    elif verb == "type":
        if len(args) != 3: sys.exit("usage: bench type ID SELECTOR TEXT")
        request["id"], request["selector"], request["text"] = args
    elif verb == "shot":
        if not args: sys.exit("usage: bench shot ID [PATH] [WIDTH]")
        request["id"] = args[0]
        if len(args) > 1: request["path"] = os.path.abspath(args[1])
        if len(args) > 2: request["width"] = float(args[2])
    elif verb == "backdrop":
        pass
    elif verb == "canvas":
        request["op"] = args[0] if args else "list"
        if request["op"] == "rowmenu" and len(args) > 2:
            args = args[:2] + [os.path.abspath(args[2])]  # the picture's path, from here
        if request["op"] == "picture" and len(args) > 1:
            args = args[:1] + [os.path.abspath(args[1])] + args[2:]
        request["arg"] = " ".join(args[1:]) if len(args) > 1 else ""
    elif verb == "split":
        request["arg"] = args[0] if args else ""
    elif verb == "swipe":
        request["arg"] = " ".join(args) if args else "left"
    elif verb == "mouse":
        request["arg"] = " ".join(args) if args else "back"
    elif verb == "bar":
        request["text"] = args[0] if args else ""
        request["go"] = "--go" in args
    elif verb == "summon":
        request["text"] = args[0] if args else ""
    elif verb == "tabs":
        if len(args) > 1 or (args and args[0] not in ("clear", "undo")):
            sys.exit("usage: bench tabs [clear|undo]")
        if args: request["op"] = args[0]
    elif verb == "newtab":
        flags = {"--go", "--keep", "--json", "--type"}
        rest, i = [], 0
        while i < len(args):
            if args[i] == "--pick" and i + 1 < len(args):
                request["pick"] = int(args[i + 1]); i += 2
            elif args[i] == "--how" and i + 1 < len(args):
                request["how"] = args[i + 1]; i += 2
            elif args[i] == "--settle" and i + 1 < len(args):
                request["settle"] = float(args[i + 1]); i += 2
            elif args[i] == "--every" and i + 1 < len(args):
                request["every"] = float(args[i + 1]); i += 2
            elif args[i] in flags:
                request[args[i][2:]] = True; i += 1
            else:
                rest.append(args[i]); i += 1
        request["text"] = rest[0] if rest else ""
    elif verb == "window":
        if not args: sys.exit("usage: bench window PATH [N]")
        request["path"] = os.path.abspath(args[0])
        if len(args) > 1: request["index"] = int(args[1])  # the Nth browser window (bench windows)
    elif verb == "passkeys":
        if not args: sys.exit("usage: bench passkeys list|count|forget --id ID|answer yes|no|ask")
        request["op"] = args[0]
        if args[0] == "forget":
            if len(args) == 3 and args[1] == "--id": request["arg"] = args[2]
            elif len(args) == 2: request["arg"] = args[1]
            else: sys.exit("usage: bench passkeys forget --id ID")
        elif args[0] == "answer":
            if len(args) != 2 or args[1] not in ("yes", "no", "ask"): sys.exit("usage: bench passkeys answer yes|no|ask")
            request["arg"] = args[1]
        elif len(args) > 1:
            sys.exit("usage: bench passkeys list|count|forget --id ID|answer yes|no|ask")
    elif verb in ("privacy", "about"):
        request["op"] = args[0] if args else "status"
        request["arg"] = " ".join(args[1:])
    elif verb == "passwords":
        # Copper's own passwords in a probe world with the file keychain; paths made absolute.
        request["op"] = args[0] if args else "status"
        rest = args[1:]
        if request["op"] in ("import", "export", "csvcheck") and rest: rest = [os.path.abspath(rest[0])] + rest[1:]
        request["arg"] = " ".join(rest)
    elif verb == "render":
        if len(args) < 2: sys.exit("usage: bench render bitwarden|onepassword[-app|-password|-service|-dark]|managers[-dark]|picker|agent|agent-dark|drive|hands|hands-dark|pill|pill-dark PATH [HOST]")
        request["op"] = args[0]
        request["path"] = os.path.abspath(args[1])
        if len(args) > 2: request["host"] = args[2]
    elif verb == "cloud":
        request["op"] = args[0] if args else "status"
        if request["op"] == "picture" and len(args) > 1: args[1] = os.path.abspath(args[1])
        request["arg"] = " ".join(args[1:]) if len(args) > 1 else ""
    elif verb == "voice":
        request["op"] = args[0] if args else "status"
        if request["op"] == "replay":
            if len(args) != 2: sys.exit("usage: bench voice replay PATH")
            request["path"] = os.path.abspath(args[1])
        elif request["op"] in ("dictate", "source", "key", "seed", "render", "prefs", "model", "state", "editor", "warm", "listen"):
            # Dictation (Fork/Voice/DictationBench.swift): the words after the op, a file path made absolute.
            rest = args[1:]
            if request["op"] in ("dictate", "source", "render") and rest and rest[0] != "off" and not rest[0].startswith("--"):
                rest[0] = os.path.abspath(rest[0])
            # Listen (Fork/Voice/ListenBench.swift): --source PATH made absolute.
            if request["op"] == "listen" and "--source" in rest and rest.index("--source") + 1 < len(rest):
                rest[rest.index("--source") + 1] = os.path.abspath(rest[rest.index("--source") + 1])
            request["args"] = rest
        elif len(args) > 1 or request["op"] not in ("selftest", "status", "result"):
            sys.exit("usage: bench voice selftest|replay PATH|status|result|dictate PATH …|source PATH|off|key …|warm …|seed …|render PATH [W] [dark]|prefs …|model …|state|editor …|listen …")
    elif verb == "settings":
        words = [a for a in args if a != "--table"]
        request["op"] = words[0] if words else "state"
        request["arg"] = " ".join(words[1:]) if len(words) > 1 else ""
    elif verb in ("spaces", "groups", "sections", "agent", "ai", "updates", "bw", "op", "downloads", "drive", "ext-manager", "windows", "flight", "trails", "pace"):
        request["op"] = args[0] if args else ("status" if verb in ("updates", "bw", "op", "drive", "pace") else "list")
        request["arg"] = " ".join(args[1:]) if len(args) > 1 else ""
    elif verb == "history":
        if not args or args[0] != "import" or len(args) < 2:
            sys.exit("usage: bench history import arc|chrome [--root PATH] [--limit N]")
        request["op"] = "import"
        request["source"] = args[1]
        i = 2
        while i < len(args):
            if args[i] == "--root" and i + 1 < len(args):
                request["root"] = args[i + 1]; i += 2
            elif args[i] == "--limit" and i + 1 < len(args):
                request["limit"] = int(args[i + 1]); i += 2
            else:
                sys.exit("usage: bench history import arc|chrome [--root PATH] [--limit N]")
    elif verb == "storage":
        usage = "usage: bench storage import PATH [--only ORIGIN] [--profile-store NAME] | storage status"
        if not args or args[0] not in ("import", "status"): sys.exit(usage)
        request["op"] = args[0]
        if args[0] == "import":
            if len(args) < 2: sys.exit(usage)
            request["path"] = os.path.abspath(args[1])
            rest = args[2:]
            while rest:
                if rest[0] == "--only" and len(rest) > 1: request["only"] = rest[1]
                elif rest[0] == "--profile-store" and len(rest) > 1: request["profileStore"] = rest[1]
                else: sys.exit(usage)
                rest = rest[2:]
    elif verb == "flow":
        if not args: sys.exit("usage: bench flow sources|root|scan|bookmarks|bookmark-move|move|status|localstorage|open|close|state|events|key|pick|shot|activate|limit|choose|access|allow|passphrase|secrets|export|back|file|file-status|guide|done|undo|registry|spaces|slow")
        request["op"] = args[0]
        rest = args[1:]
        if args[0] == "key" and rest and not rest[0].startswith("--"):
            request["key"] = rest[0]; rest = rest[1:]
        if args[0] == "access" and rest and rest[-1] in ("locked", "clear"):
            request["state"] = rest[-1]; rest = rest[:-1]
        i = 0
        while i < len(rest):
            if rest[i] == "--via" and i + 1 < len(rest):
                request["via"] = rest[i + 1]; i += 2
            elif rest[i] == "--window" and i + 1 < len(rest):
                request["window"] = int(rest[i + 1]); i += 2
            elif rest[i] == "--seconds" and i + 1 < len(rest):
                request["seconds"] = float(rest[i + 1]); i += 2
            elif rest[i] == "--clear":
                request["clear"] = True; i += 1
            elif rest[i] == "--all":
                request["all"] = True; i += 1
            elif rest[i] == "--source" and i + 1 < len(rest):
                request["source"] = rest[i + 1]; i += 2
            elif rest[i] == "--path" and i + 1 < len(rest):
                request["path"] = rest[i + 1]; i += 2
            elif rest[i] == "--only" and i + 1 < len(rest):
                request["only"] = rest[i + 1]; i += 2
            elif rest[i] == "--id" and i + 1 < len(rest):
                request["id"] = rest[i + 1]; i += 2
            elif rest[i] == "--root" and i + 1 < len(rest):
                request["root"] = os.path.abspath(rest[i + 1]); i += 2
            elif rest[i] == "--zip" and i + 1 < len(rest):
                request["zip"] = os.path.abspath(rest[i + 1]); i += 2
            elif rest[i] == "--real":
                request["real"] = True; i += 1
            elif rest[i] == "--again":
                request["again"] = True; i += 1
            else:
                i += 1
    elif verb == "ui":
        if len(args) != 2: sys.exit("usage: bench ui KEY VALUE")
        key, value = args
        if key == "width": request[key] = float(value)
        elif key in ("look", "focus", "tabswitch", "page"): request[key] = value
        else: request[key] = value in ("on", "true", "1", "yes")
    elif verb in ("ext-add", "ext-press", "ext-remove", "ext-reload"):
        if len(args) != 1: sys.exit(f"usage: bench {verb} ID")
        request["id"] = args[0]
        request["yes"] = yes
    elif verb == "ext-enable":
        if len(args) != 2: sys.exit("usage: bench ext-enable ID on|off")
        request["id"] = args[0]
        request["on"] = args[1] in ("on", "true", "1", "yes")
    elif verb == "ext-pin":
        if not 1 <= len(args) <= 2: sys.exit("usage: bench ext-pin ID [on|off]")
        request["id"] = args[0]
        request["on"] = (args[1] if len(args) > 1 else "on") in ("on", "true", "1", "yes")
    elif verb == "ext-answer":
        if len(args) != 1 or args[0] not in ("yes", "no", "ask"): sys.exit("usage: bench ext-answer yes|no|ask")
        request["answer"] = args[0]
    elif verb == "ext-shot":
        if len(args) != 2: sys.exit("usage: bench ext-shot ID PATH")
        request["id"] = args[0]
        request["path"] = os.path.abspath(args[1])
    elif verb == "ext-menu":
        if len(args) != 1: sys.exit("usage: bench ext-menu PATH")
        request["path"] = os.path.abspath(args[0])
    elif verb == "ext-folder":
        if len(args) != 1: sys.exit("usage: bench ext-folder PATH")
        request["path"] = os.path.abspath(args[0])
        request["yes"] = yes
    elif verb == "ext-popup":
        if len(args) != 2: sys.exit("usage: bench ext-popup ID JS")
        request["id"], request["js"] = args
    elif verb == "ext-page":
        if not args: sys.exit("usage: bench ext-page ID [PATH]")
        request["id"] = args[0]
        request["path"] = args[1] if len(args) > 1 else ""
    elif verb in ("hardreload", "inspect"):
        if len(args) > 1: sys.exit(f"usage: bench {verb} [ID]")
        if args: request["id"] = args[0]
    elif verb == "key":
        via_app = "--app" in args
        hold = "--hold" in args
        args = [a for a in args if a not in ("--app", "--hold")]
        if len(args) != 2: sys.exit("usage: bench key ID TEXT [--app] [--hold]")
        request["id"], request["text"] = args
        if via_app: request["via"] = "app"
        if hold: request["hold"] = True
    elif verb == "mcp":
        # `mcp transcript …` (Fork/MCP/VoiceTools.swift) rides the agent server's own bench verb.
        if len(args) < 2 or args[0] != "transcript":
            sys.exit("usage: bench mcp transcript begin|append TEXT|live on|off|forget|share on|off|state|check")
        request = {"do": "agent", "op": "transcript", "arg": " ".join(args[1:])}
    elif verb == "resize":
        if len(args) not in (2, 3): sys.exit("usage: bench resize WIDTH HEIGHT [STEPS]")
        request["width"], request["height"] = float(args[0]), float(args[1])
        if len(args) == 3: request["steps"] = int(args[2])
    elif verb in ("pin", "unpin", "reorder"):
        if "--window" in args:
            at = args.index("--window")
            if at + 1 >= len(args) or not args[at + 1].isdigit(): sys.exit(f"usage: bench {verb} … --window N")
            request["window"] = int(args[at + 1])
            args = args[:at] + args[at + 2:]
        if verb == "pin":
            if not args or len(args) > 2: sys.exit("usage: bench pin ID [LETTER] [--window N]")
        elif verb == "unpin":
            if len(args) != 1: sys.exit("usage: bench unpin ID [--window N]")
        elif len(args) != 2 or not args[1].isdigit():
            sys.exit("usage: bench reorder ID INDEX [--window N]")
        request["id"] = args[0]
        if verb == "pin" and len(args) == 2: request["letter"] = args[1]
        if verb == "reorder": request["index"] = int(args[1])
    elif verb not in ("tabs", "probe", "extensions"):
        sys.exit(f"unknown command “{verb}” — see bench help")

    answer = ask(os.path.join(folder(world), "bench.sock"), request)
    if answer.get("error"):
        sys.exit("error: " + str(answer["error"]))
    if verb == "flow" and request.get("op") == "guide" and answer.get("started"):
        # The guide opens in Copper (a canvas page loads); ask until it has.
        import time
        for _ in range(60):
            time.sleep(0.5)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "flow", "op": "status"})
            if answer.get("guide") in ("opened", "failed"): break
    if verb == "flow" and request.get("op") == "file" and answer.get("started"):
        # A file is read and merged off Copper's main thread; ask until done.
        import time
        while True:
            time.sleep(0.1)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "flow", "op": "file-status"})
            if not answer.get("running"): break
    if verb == "flow" and request.get("op") == "move" and answer.get("started"):
        # Same for a move: it runs on in Copper (keychain prompt, minutes of
        # local storage), so poll its status and print the finished report.
        import time
        while True:
            time.sleep(1)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "flow", "op": "status"})
            if not answer.get("running"): break
            print("\r" + " · ".join(answer.get("lines", []))[-120:], end="", file=sys.stderr, flush=True)
        print(file=sys.stderr)
    if verb == "mcp" and answer.get("running"):
        # `mcp transcript check` runs in the app; ask for its answer.
        import time
        for _ in range(50):
            time.sleep(0.2)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "agent", "op": "transcript", "arg": "check-result"})
            if not answer.get("running"): break
        if answer.get("error"): sys.exit("error: " + str(answer["error"]))
        print(json.dumps(answer, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if answer.get("ok") else 1
    if verb == "voice" and answer.get("running"):
        # The first load on a Mac prepares the Neural Engine for a minute or
        # more, past the bench's 25 s: ask for the job's answer until it's in.
        import time
        started = time.time()
        while answer.get("running") and time.time() - started < 900:
            print(f"\rvoice {answer.get('job', '')}: {time.time() - started:.0f} s", end="", file=sys.stderr, flush=True)
            time.sleep(2)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "voice", "op": "result"})
        print(file=sys.stderr)
        if answer.get("error"):
            sys.exit("error: " + str(answer["error"]))
    if verb == "voice":
        print(json.dumps(answer, ensure_ascii=False, indent=2, sort_keys=True))
        return 1 if answer.get("failures") or answer.get("running") else 0
    if verb == "storage" and answer.get("started"):
        # The import runs on in Copper; the bench answers within 25 s, so ask
        # for the report until it is done rather than holding one request.
        import time
        while True:
            time.sleep(1)
            answer = ask(os.path.join(folder(world), "bench.sock"), {"do": "storage", "op": "status"})
            print(f"\r{answer.get('done')}/{answer.get('total')} origins", end="", file=sys.stderr, flush=True)
            if not answer.get("running"): break
        print(file=sys.stderr)
    if verb == "text":
        print(answer.get("text", ""))
        if answer.get("truncated"):
            print("\n[… truncated]", file=sys.stderr)
    elif verb == "shot":
        print(answer["path"])
    elif verb in ("open", "ext-page"):
        print(answer["id"])
    elif verb in ("eval", "ext-popup"):
        value = answer.get("value")
        print(value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2))
    elif verb == "canvas":
        print(json.dumps(answer, ensure_ascii=False, indent=2, sort_keys=True))
    elif verb in ("updates", "bw", "op", "drive", "render", "hardreload", "inspect"):
        print(json.dumps(answer, ensure_ascii=False, sort_keys=True))
    elif verb == "settings" and request["op"] == "search" and "--table" in args:
        for r in answer.get("results", []):
            print(f"{r['rank']:>2}  {r['score']:>6}  {r['page']:<12} {r['marked']}")
    elif verb == "cloud":
        print(json.dumps(answer, ensure_ascii=False, sort_keys=True, indent=2))
    elif verb == "newtab" and request.get("type"):
        if request.get("json"):
            print(json.dumps(answer, ensure_ascii=False, indent=2))
            return 0
        keys = answer.get("keyMs", [])
        print(f"typed “{answer.get('typed')}”, a letter every {answer.get('every', 0) * 1000:.0f} ms → {answer.get('rows')} rows")
        print(f"open:    {answer.get('openMs', 0):.1f} ms to launch, {answer.get('openBusyMs', 0):.1f} ms busy, longest {answer.get('openLongestMs', 0):.1f} ms")
        print(f"keys:    {', '.join(f'{k:.1f}' for k in keys)} ms (worst {answer.get('keyMaxMs', 0):.1f})")
        print(f"main:    {answer.get('busyMs', 0):.1f} ms busy, longest {answer.get('longestMs', 0):.1f} ms, "
              f"{answer.get('over16')} stretches over a frame, {answer.get('over50')} over 50 ms")
        landed = answer.get("historyMs", -1)
        print(f"history: {'%.0f ms after the last letter' % landed if landed >= 0 else 'not in before --settle ran out'}")
    elif verb == "newtab":
        if request.get("json"):
            print(json.dumps(answer, ensure_ascii=False, indent=2))
            return 0
        picked = answer.get("picked", -1)
        for g in answer.get("groups", []):
            if g.get("heading"): print(f"— {g['heading']}")
            for r in g.get("rows", []):
                mark = "›" if r["index"] == picked else " "
                extra = "  ".join(x for x in (r.get("detail"), r.get("badge")) if x)
                aside = f"  [{r['aside']}]" if r.get("aside") and r["index"] == picked else ""
                print(f"{mark} {r['index']:2} {r['kind']:8} {r['key']}  {extra}  → {r['hint']}{aside}")
        print(f"latency: {answer.get('milliseconds', 0):.2f} ms  suggest asks: {answer.get('suggestAsks')}  cancelled: {answer.get('suggestCancelled')}")
        print(f"tabs: {answer.get('tabsBefore')} → {answer.get('tabsAfter')}  active: {answer.get('active', {}).get('title', '')}  space: {answer.get('space', '')}")
    elif verb == "bar":
        for o in answer.get("offers", []):
            badge = f"  {o['badge']}" if o.get("badge") else ""
            print(f"{o['kind']:9} {o['key']}  {o['title']}{badge}")
        if answer.get("completion"):
            print(f"completion: {answer['completion']}")
        if answer.get("milliseconds") is not None:
            print(f"latency: {answer['milliseconds']:.2f} ms")
    elif verb == "spaces":
        if "slide" in answer: print(json.dumps(answer["slide"], ensure_ascii=False))
        if "preview" in answer: print(json.dumps(answer["preview"], ensure_ascii=False, sort_keys=True))
        if "pinCount" in answer:
            print(f"global pins: {answer['pinCount']}")
            for pin in answer.get("pins", []):
                print(f"  {pin.get('id', '')}  {pin.get('letter', '')}  {pin.get('title') or '—'}  {pin.get('url', '')}")
        if "sheet" in answer: print(json.dumps(answer["sheet"], ensure_ascii=False))
        if "path" in answer: print(answer["path"])
        if "page" in answer: print(f"page: {answer['page'] or 'closed'}" + (f"  (current: {answer['current']})" if answer.get("current") else ""))
        for s in answer.get("spaces", []):
            icon = f" {s['icon']}" if s.get("icon") else ""
            print(f"{'●' if s['current'] else ' '} {s['index']}  {s['name']}{icon}  ({s['tabs']} tabs, {s['profile']}, {s.get('colour', '')})")
            if s.get("theme") and s["theme"] != "hue": print(f"      theme {s['theme']}")
    elif verb == "sections":
        if "archived" in answer:
            print(f"archived {answer['archived']} tab(s)")
            if not answer["archived"]:
                print(f"  nothing in Today is older than the window — oldest row is {answer.get('oldest')}h;"
                      f" `sections archive HOURS` sweeps against that age instead")
        print(f"archive window: {answer.get('window')}, oldest row in Today: {answer.get('oldest')}h")
        # Favourites (pins) are one set shown in every space: counted once.
        print(f"favourites: {answer.get('favourites', 0)} (every space)")
        for s in answer.get("spaces", []):
            print(f"{'●' if s['current'] else ' '} {s['name']:22} {s['saved']:4} saved  {s['today']:4} today")
        for t in answer.get("today", []):
            print(f"    {t['id']}  {t['seen']}h  {t['title'] or '—'}")
    elif verb == "trails" and "trails" in answer:
        for k in ("error", "opened", "draft", "sending"):
            if k in answer: print(f"{k}: {answer[k]}")
        print(f"tide: {answer.get('tide')}  glancing: {answer.get('glancing')}")
        for t in answer["trails"]:
            mark = "●" if t["live"] else " "
            fold = "" if len(t["pages"]) == 1 else ("▾ " if t["open"] else "▸ ")
            q = "🔍 " if t["searched"] else ""
            print(f"{mark} {t['index']:2} {fold}{q}{t['title']}  [{t['place']}, {t['hours']}h, {len(t['pages'])} page(s)]  {t['id']}")
            if len(t["pages"]) > 1:
                for p in t["pages"]:
                    z = " z" if p.get("asleep") else ""
                    print(f"        {'  ' * p['depth']}└ {p['id']}  {p['title'] or '—'}{z}")
    elif verb == "tabs" and request.get("op"):
        if "cleared" in answer:
            print(f"cleared {answer['cleared']} tab(s)")
        if "restored" in answer:
            print(f"restored {answer['restored']} tab(s)")
    elif verb == "tabs":
        for tab in answer.get("tabs", []):
            mark = "⚗" if tab.get("bench") else ("●" if tab.get("active") else " ")
            state = " …" if tab.get("loading") else (" z" if tab.get("asleep") else "")
            pin = f"[{tab['pin']}] " if tab.get("pin") else ""
            print(f"{mark} {tab['id']}  {pin}{tab.get('title') or '—'}  {tab.get('url')}{state}")
    else:
        print(json.dumps(answer, ensure_ascii=False, indent=2))
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
